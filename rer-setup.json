{
  "schema": 1,
  "title": "Mango",
  "groups": [
    {
      "id": "owner",
      "label": "First owner"
    },
    {
      "id": "configuration",
      "label": "Installation configuration"
    },
    {
      "id": "mail",
      "label": "Newsletter mail provider",
      "help": "Managed hosting includes RER mail for sign-in and consent confirmations, supplied by RER. Add the optional newsletter connection below to send newsletters. Free and Assisted hosting use your own SendGrid or Resend account. Newsletter sender identity is completed in Mango."
    },
    {
      "id": "marketing-mail",
      "label": "Optional newsletter connection",
      "help": "On Managed hosting, connect your own SendGrid or Resend account to send newsletters. Leave this connection empty to keep newsletter sending off. Sign-in and consent confirmations continue through RER. Mango uses your saved business sender identity for newsletters."
    }
  ],
  "fields": [
    {
      "name": "OWNER_EMAIL",
      "label": "Owner email",
      "help": "The first owner of this hosted Mango installation.",
      "kind": "email",
      "required": true,
      "prefill": "account-email",
      "group": "owner"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "configuration"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Private setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "configuration"
    },
    {
      "name": "CONTACT_HASH_SALT",
      "label": "Contact authority salt",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "configuration"
    },
    {
      "name": "IDENTITY_PROVIDER",
      "label": "Identity provider",
      "kind": "url",
      "required": false,
      "help": "Optional Auth install. Leave empty to use email links.",
      "default": ""
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Mail provider",
      "kind": "select",
      "required": true,
      "default": "sendgrid",
      "options": [
        {
          "value": "rer",
          "label": "RER managed mail"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        },
        {
          "value": "resend",
          "label": "Resend"
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_FROM",
      "label": "Sign-in sender email",
      "kind": "email",
      "required": true,
      "help": "RER supplies this address for Managed hosting. Otherwise use an address verified by your mail provider.",
      "group": "mail"
    },
    {
      "name": "MAIL_RELAY_URL",
      "label": "Managed mail relay URL",
      "kind": "url",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "group": "mail"
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Mail provider API key",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "mail",
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        }
      ]
    },
    {
      "name": "MAIL_WEBHOOK_SECRET",
      "label": "Mail webhook verification key",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "help": "Optional for SendGrid: its signed Event Webhook public key, which turns Accepted into Delivered, bounced and complaint reports. Required for Resend: its webhook signing secret.",
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": false
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_WEBHOOK_ID",
      "label": "Resend webhook ID",
      "kind": "text",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "resend"
      },
      "group": "mail"
    },
    {
      "name": "MANGO_ALLOWED_LINK_HOSTS",
      "label": "Allowed newsletter link hosts",
      "kind": "text",
      "required": false,
      "help": "Defaults to this app’s own host. Change it later in Mango Settings, or enter comma-separated host names such as shop.example.com.",
      "group": "mail"
    },
    {
      "name": "MARKETING_MAIL_PROVIDER",
      "label": "Newsletter provider",
      "kind": "select",
      "required": false,
      "default": "",
      "options": [
        {
          "value": "",
          "label": "Set up later"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        },
        {
          "value": "resend",
          "label": "Resend"
        }
      ],
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "group": "marketing-mail"
    },
    {
      "name": "MARKETING_MAIL_API_KEY",
      "label": "Newsletter provider API key",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "presentations": [
        {
          "when": {
            "field": "MARKETING_MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MARKETING_MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        }
      ],
      "group": "marketing-mail"
    },
    {
      "name": "MARKETING_MAIL_WEBHOOK_SECRET",
      "label": "Newsletter webhook verification key",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "help": "Optional for SendGrid: its signed Event Webhook public key enables delivery, bounce and complaint reports. Required for Resend: its webhook signing secret.",
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "presentations": [
        {
          "when": {
            "field": "MARKETING_MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": false
        },
        {
          "when": {
            "field": "MARKETING_MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        }
      ],
      "group": "marketing-mail"
    },
    {
      "name": "MARKETING_MAIL_WEBHOOK_ID",
      "label": "Newsletter Resend webhook ID",
      "kind": "text",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "presentations": [
        {
          "when": {
            "field": "MARKETING_MAIL_PROVIDER",
            "equals": "resend"
          }
        }
      ],
      "group": "marketing-mail"
    },
    {
      "name": "MAIL_AUTH_FROM",
      "label": "Legacy sign-in sender email",
      "help": "Optional compatibility input for existing direct-provider installations. Prefer Sign-in sender email for new installations.",
      "kind": "email",
      "required": false,
      "group": "mail"
    },
    {
      "name": "MAIL_PROVIDER_API_KEY",
      "label": "Legacy mail provider API key",
      "help": "Optional compatibility input for existing SendGrid or Resend installations. Prefer Mail provider API key for new installations.",
      "kind": "secret",
      "required": false,
      "ownerVisible": true,
      "input": "entered",
      "group": "mail"
    }
  ],
  "steps": [
    {
      "type": "owner-claim",
      "mode": "signed",
      "emailField": "OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN",
      "path": "/auth/owner-claim"
    }
  ],
  "dependencies": [
    {
      "interface": "oidc-provider@1",
      "optional": true,
      "cardinality": 1,
      "address": "IDENTITY_PROVIDER",
      "paths": [
        "/auth/oidc/auth/callback",
        "/auth/oidc/auth/logout"
      ]
    }
  ],
  "business": {
    "settings": 1,
    "values": [
      "display_name"
    ],
    "team": {
      "roles": {
        "admin": "admin",
        "member": "member"
      }
    }
  }
}
