{
  "name": "mango",
  "private": true,
  "version": "0.4.0",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "22.20.0"
  },
  "type": "module",
  "scripts": {
    "config:local": "node scripts/generate-local-wrangler-config.mjs",
    "config:production": "node scripts/generate-production-wrangler-config.mjs",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "dev": "rer dev",
    "preview": "rer preview",
    "build": "rer build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "test": "node scripts/verification/run.mjs --tests-only",
    "verify": "rer verify",
    "verify:managed": "rer check --profile first-party && pnpm run source:check && pnpm run typecheck && pnpm run integration:check",
    "review:synthetic": "node scripts/start-synthetic-review.mjs",
    "source:inspect": "node scripts/edition-authoring/cli.mjs inspect",
    "source:lock": "node scripts/edition-authoring/cli.mjs lock",
    "source:check": "node scripts/edition-authoring/cli.mjs check && node scripts/edition-authoring/cli.mjs verify-base --offline",
    "source:changes": "node scripts/edition-authoring/cli.mjs changes",
    "source:release": "node scripts/edition-authoring/cli.mjs release",
    "source:receipt": "node scripts/edition-authoring/cli.mjs receipt",
    "test:local-start": "playwright test --config scripts/verification/local-start.config.mjs",
    "test:campaign-results": "playwright test --config tests/campaign-results/playwright.config.js",
    "auth:rotate": "node scripts/installer/rotate.mjs",
    "build:worker": "pnpm config:production && vite build",
    "export": "rer export",
    "import": "rer import",
    "verify:app": "node scripts/verification/run.mjs",
    "reset": "rer reset",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "artifact:delivery": "node scripts/build-delivery-artifact.mjs",
    "hosted": "node scripts/installer/hosted.mjs",
    "integration:sync": "node scripts/sync-integration.mjs --write",
    "integration:check": "node scripts/sync-integration.mjs --check && node scripts/agent-surface.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.5",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@playwright/test": "^1.64.1",
    "@runeditrun/rer": "0.2.94",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "highlight.js": "10.7.3",
    "miniflare": "5.20260907.0-alpha",
    "react-markdown": "6.0.3",
    "remark-gfm": "1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^8.2.2",
    "wrangler": "^4.129.1"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "4.13.7",
    "parse5": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.1.5"
  },
  "pnpm": {
    "overrides": {
      "miniflare>sharp": "0.35.5",
      "miniflare>undici": "7.29.1",
      "source-map-js": "1.2.2",
      "drizzle-kit@0.31.10>@esbuild-kit/esm-loader": "-"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
